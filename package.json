{
  "name": "ifaf-achievements-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:migrate": "dotenv -e .env.local --override -- prisma migrate dev",
    "db:reset": "dotenv -e .env.local --override -- prisma migrate reset",
    "db:deploy": "dotenv -e .env.local --override -- prisma migrate deploy",
    "db:status": "dotenv -e .env.local --override -- prisma migrate status",
    "db:seed": "dotenv -e .env.local --override -- prisma db seed",
    "import:ifaf": "dotenv -e .env.local --override -- node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/import-ifaf.ts",
    "test": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/lib/reference/parse-class-code.test.ts src/lib/search/category-query.test.ts src/lib/import/*.test.ts src/lib/records/*.test.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.23",
    "@heroicons/react": "^2.2.0",
    "@prisma/adapter-pg": "6.19.0",
    "@prisma/client": "6.19.0",
    "better-auth": "^1.7.23",
    "daisyui": "^5.8.0",
    "exceljs": "^4.4.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "6.19.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.17.0"
}
