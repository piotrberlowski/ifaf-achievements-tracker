generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider  = "postgresql"
  url       = env("IFAF_AT_POSTGRES_PRISMA_URL")
  directUrl = env("IFAF_AT_POSTGRES_URL_NON_POOLING")
}

enum DivisionGender {
  male
  female

  @@map("division_gender")
}

enum SubmissionStatus {
  pending
  approved
  rejected

  @@map("submission_status")
}

enum SubmissionSource {
  api
  csv
  xlsx
  import

  @@map("submission_source")
}

enum ClaimStatus {
  pending
  approved
  rejected

  @@map("claim_status")
}

enum AwardLevel {
  bronze
  silver
  gold
  hotshot
  star

  @@map("award_level")
}

enum PinStatus {
  pending
  issued

  @@map("pin_status")
}

model User {
  id                  String              @id
  name                String
  email               String
  emailVerified       Boolean             @default(false)
  image               String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  sessions            Session[]
  accounts            Account[]
  permissions         PermissionGrant[]
  membershipClaims    MembershipClaim[]   @relation("Claimant")
  claimsReviewed      MembershipClaim[]   @relation("ClaimReviewer")
  namesApproved       PersonName[]        @relation("NameApprover")
  submissionsApproved ScoreSubmission[]   @relation("SubmissionApprover")
  submissionsRejected ScoreSubmission[]   @relation("SubmissionRejector")
  integrationClients  IntegrationClient[] @relation("CredentialIssuer")

  @@unique([email])
  @@map("user")
}

model PermissionGrant {
  id         String   @id
  userId     String
  permission String
  grantedBy  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@index([userId])
  @@map("permission_grant")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verification")
}

// A score is append-only. An amendment stamps tombstoned and writes a new score.
// record_standing is the current holder for each class, refreshed after a
// score is written or tombstoned. Pins are stored with status pending or issued.

model Person {
  id               String            @id @default(cuid())
  membershipNumber String            @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  names            PersonName[]
  claims           MembershipClaim[]
  scores           Score[]
  gainsAwards      GainsAward[]

  @@map("person")
}

model PersonName {
  id           String    @id @default(cuid())
  personId     String
  fullName     String
  note         String?
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  person       Person    @relation(fields: [personId], references: [id], onDelete: Restrict)
  approvedBy   User?     @relation("NameApprover", fields: [approvedById], references: [id], onDelete: Restrict)

  @@index([personId, approvedAt])
  @@index([fullName])
  @@map("person_name")
}

model BowStyle {
  id         String            @id @default(cuid())
  code       String            @unique
  name       String
  entries    SubmissionEntry[]
  scores     Score[]
  gainsAwards GainsAward[]

  @@map("bow_style")
}

model AgeDivision {
  id          String            @id @default(cuid())
  code        String            @unique
  name        String
  entries     SubmissionEntry[]
  scores      Score[]
  gainsAwards GainsAward[]

  @@map("age_division")
}

model AwardTrack {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  rounds      Round[]
  gainsAwards GainsAward[]

  @@map("award_track")
}

model Round {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  awardTrackId String
  displayOnly  Boolean       @default(false)
  awardTrack   AwardTrack    @relation(fields: [awardTrackId], references: [id], onDelete: Restrict)
  competitions Competition[]

  @@map("round")
}

model IntegrationClient {
  id                     String            @id @default(cuid())
  name                   String
  certificateFingerprint String?           @unique
  secretHash             String?
  issuedById             String
  createdAt              DateTime          @default(now())
  revokedAt              DateTime?
  issuedBy               User              @relation("CredentialIssuer", fields: [issuedById], references: [id], onDelete: Restrict)
  submissions            ScoreSubmission[]

  @@map("integration_client")
}

model Competition {
  id             String           @id @default(cuid())
  name           String
  startsOn       DateTime?        @db.Date
  roundCode      String
  roundId        String?
  countsForGains Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  round          Round?           @relation(fields: [roundId], references: [id], onDelete: Restrict)
  submission     ScoreSubmission?
  scores         Score[]

  @@map("competition")
}

model ScoreSubmission {
  id                  String             @id @default(cuid())
  competitionId       String             @unique
  status              SubmissionStatus   @default(pending)
  source              SubmissionSource
  externalId          String?
  integrationClientId String?
  approvedById        String?
  approvedAt          DateTime?
  rejectedById        String?
  rejectedAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  competition         Competition        @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  integrationClient   IntegrationClient? @relation(fields: [integrationClientId], references: [id], onDelete: Restrict)
  approvedBy          User?              @relation("SubmissionApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  rejectedBy          User?              @relation("SubmissionRejector", fields: [rejectedById], references: [id], onDelete: Restrict)
  entries             SubmissionEntry[]

  @@unique([integrationClientId, externalId])
  @@index([status])
  @@map("score_submission")
}

model SubmissionEntry {
  id               String          @id @default(cuid())
  submissionId     String
  membershipNumber String
  archerName       String
  club             String?
  classCode        String
  bowStyleId       String?
  ageDivisionId    String?
  gender           DivisionGender?
  score            Int?
  scoreId          String?         @unique
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  submission       ScoreSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  bowStyle         BowStyle?       @relation(fields: [bowStyleId], references: [id], onDelete: Restrict)
  ageDivision      AgeDivision?    @relation(fields: [ageDivisionId], references: [id], onDelete: Restrict)
  approvedScore    Score?          @relation(fields: [scoreId], references: [id], onDelete: Restrict)

  @@index([bowStyleId, ageDivisionId, gender])
  @@index([submissionId])
  @@map("submission_entry")
}

model Score {
  id            String         @id @default(cuid())
  personId      String
  bowStyleId    String
  ageDivisionId String
  gender        DivisionGender
  competitionId String
  score         Int
  tombstoned    Boolean        @default(false)
  createdAt     DateTime       @default(now())
  person        Person         @relation(fields: [personId], references: [id], onDelete: Restrict)
  bowStyle      BowStyle       @relation(fields: [bowStyleId], references: [id], onDelete: Restrict)
  ageDivision   AgeDivision    @relation(fields: [ageDivisionId], references: [id], onDelete: Restrict)
  competition   Competition    @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  entry         SubmissionEntry?

  @@index([bowStyleId, ageDivisionId, gender])
  @@index([personId, bowStyleId, ageDivisionId, gender])
  @@index([competitionId])
  @@map("score")
}

view RecordStanding {
  scoreId        String
  roundId        String
  roundCode      String
  roundName      String
  displayOnly    Boolean
  awardTrackCode String
  bowStyleId     String
  bowCode        String
  ageDivisionId  String
  ageCode        String
  gender         DivisionGender
  personId       String
  score          Int
  effectiveOn    DateTime?      @db.Date
  recognisedOn   DateTime?      @db.Date
  eventName      String
  holder         String

  @@unique([scoreId])
  @@map("record_standing")
}

model GainsAward {
  id            String         @id @default(cuid())
  personId      String
  bowStyleId    String
  ageDivisionId String
  gender        DivisionGender
  awardTrackId  String
  level         AwardLevel
  status        PinStatus      @default(pending)
  issuedOn      DateTime?      @db.Date
  createdAt     DateTime       @default(now())
  person        Person         @relation(fields: [personId], references: [id], onDelete: Restrict)
  bowStyle      BowStyle       @relation(fields: [bowStyleId], references: [id], onDelete: Restrict)
  ageDivision   AgeDivision    @relation(fields: [ageDivisionId], references: [id], onDelete: Restrict)
  awardTrack    AwardTrack     @relation(fields: [awardTrackId], references: [id], onDelete: Restrict)

  @@unique([personId, bowStyleId, ageDivisionId, gender, awardTrackId, level])
  @@index([bowStyleId, ageDivisionId, gender])
  @@map("gains_award")
}

model MembershipClaim {
  id               String      @id @default(cuid())
  userId           String
  membershipNumber String
  personId         String?
  status           ClaimStatus @default(pending)
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  user             User        @relation("Claimant", fields: [userId], references: [id], onDelete: Cascade)
  person           Person?     @relation(fields: [personId], references: [id], onDelete: Restrict)
  reviewedBy       User?       @relation("ClaimReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([membershipNumber])
  @@map("membership_claim")
}
