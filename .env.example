# Runtime connection. On Vercel this is IFAF_AT_POSTGRES_PRISMA_URL.
IFAF_AT_POSTGRES_PRISMA_URL=

# Direct connection used by Prisma migrations.
IFAF_AT_POSTGRES_URL_NON_POOLING=

# Better Auth. Production hosts are https://gains.fieldarchery.app
# and https://records.fieldarchery.app. BETTER_AUTH_URL is the GAINS host.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth.
# Local: http://localhost:3000/api/auth/callback/google
# Production: https://gains.fieldarchery.app/api/auth/callback/google
# Production: https://records.fieldarchery.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Auth0.
# Callbacks:
# Local: http://localhost:3000/api/auth/callback/auth0
# Production: https://gains.fieldarchery.app/api/auth/callback/auth0
# Production: https://records.fieldarchery.app/api/auth/callback/auth0
# Allowed Logout URLs: http://localhost:3000/,
# https://gains.fieldarchery.app/, and https://records.fieldarchery.app/
# Application Login URI: https://gains.fieldarchery.app/login
AUTH_AUTH0_ID=
AUTH_AUTH0_SECRET=
AUTH_AUTH0_ISSUER=

# Comma-separated emails that receive system.admin on sign-in.
SYSTEM_ADMIN_EMAILS=
