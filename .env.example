# Runtime connection. On Vercel this is IFAF_AT_POSTGRES_PRISMA_URL.
IFAF_AT_POSTGRES_PRISMA_URL=

# Direct connection used by Prisma migrations.
IFAF_AT_POSTGRES_URL_NON_POOLING=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth. Redirect: {BETTER_AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Auth0. Redirect: {BETTER_AUTH_URL}/api/auth/callback/auth0
AUTH_AUTH0_ID=
AUTH_AUTH0_SECRET=
AUTH_AUTH0_ISSUER=
